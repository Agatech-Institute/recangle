{
  "expo": {
    "name": "angle",
    "slug": "rectangle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/anglelgs.png",
    "scheme": "rectangle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/anglelgc.png",
        "backgroundImage": "./assets/images/anglelgc.png",
        "monochromeImage": "./assets/images/anglelgc.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.djmanuwave.rectangle"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-video",
      "expo-audio",
      "expo-web-browser",
      "expo-secure-store",
      "expo-asset",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17d675a4-3916-41d8-9ed9-e086a6585c6d"
      }
    }
  }
}
